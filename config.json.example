{
  "server": {
    "host": "127.0.0.1",
    "port": 8765
  },
  "comfy": {
    "url": "http://127.0.0.1:8188",
    "workflows_dir": "./workflows",
    "http_timeout_seconds": 15,
    "status_timeout_seconds": 2,
    "status_refresh_seconds": 10,
    "poll_interval_seconds": 1,
    "generation_timeout_seconds": 600,
    "preview_max_edge": 512,
    "media_profiles": {
      "image": {
        "source": "profiles",
        "production": "cielbleu-v2-innie-detailslider",
        "preview": "cielbleu-v2-innie-detailslider"
      },
      "video": {
        "source": "profiles",
        "production": "ltx-2-5-i2v"
      }
    }
  },
  "prompt_enhancer": {
    "production": false,
    "preview": false,
    "url": "http://127.0.0.1:1234",
    "models": [
      {
        "model": "qwen3.8-27b-q4-heretic"
      },
      {
        "model": "gemma4-12b-q4-heretic"
      }
    ],
    "image_model": "qwen3.8-27b-q4-heretic",
    "video_model": "qwen3.8-27b-q4-heretic",
    "instructions_image": "./instructions/image-inference.md.example",
    "instructions_video": "./instructions/video-inference.md.example",
    "api_key_env": "LLAMA_API_KEY",
    "timeout_seconds": 120,
    "parallel": 4,
    "max_tokens": 450,
    "temperature": 0.6,
    "top_p": 0.85,
    "top_k": 20,
    "min_p": 0.0,
    "presence_penalty": 0.0,
    "repeat_penalty": 1.0
  },
  "storage": {
    "output_dir": "./outputs",
    "proofs_dir": [],
    "output_format": "jpg",
    "jpeg_quality": 95,
    "prompt_debug_log": {
      "enabled": true,
      "path": "./outputs/prompt-debug.jsonl"
    }
  },
  "gallery": {
    "thumbnail_cache_mb": 512,
    "thumbnail_max_edge": 512
  },
  "interface": {
    "privacy": {
      "auto_cover_minutes": [
        5,
        15
      ]
    }
  },
  "limits": {
    "max_scene_attempts": 100,
    "max_storyboards": 20,
    "max_jobs": 40,
    "max_previews": 8
  }
}
